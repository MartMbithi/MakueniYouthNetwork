APP_ENV=local
APP_URL=http://localhost:8000
APP_KEY=

DB_HOST=127.0.0.1
DB_NAME=myn
DB_USER=root
DB_PASS=

# Mail (SMTP), Paystack and Google Analytics are configured via the admin
# back office at /admin/settings — not here. Their values are stored in the
# `settings` database table so they can be rotated without redeploying and
# don't accidentally end up in a committed .env file.
#
# First-run flow:
#   1. Bring this app up with just the DB + APP_* keys above filled in.
#   2. Log in at /admin/login (seed credentials in README.md) and rotate
#      the password.
#   3. Open /admin/settings and configure SMTP, Paystack and GA from there.
