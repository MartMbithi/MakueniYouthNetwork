RewriteEngine On

# Pass Authorization header to PHP (some CGI setups strip it)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# -------------------------------------------------------------------------
# Force HTTPS in production (skipped for localhost / 127.0.0.1 so local
# Apache testing still works). `php -S` does not honour .htaccess.
# -------------------------------------------------------------------------
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost(:[0-9]+)?$ [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:[0-9]+)?$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# -------------------------------------------------------------------------
# Hide stack identifiers (defence in depth — don't volunteer "Apache/2.4.x
# (Unix) PHP/8.2" to attackers via the Server header)
# -------------------------------------------------------------------------
ServerSignature Off

# -------------------------------------------------------------------------
# Security headers
# -------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "0"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(self)"
    Header set Cross-Origin-Opener-Policy "same-origin"
    Header set Cross-Origin-Resource-Policy "same-site"

    # Content-Security-Policy: tight default. External origins:
    #   - Google Fonts (Hanken Grotesk + Fraunces, CSS + woff2)
    #   - Paystack (checkout iframe + API)
    #   - jsDelivr CDN (admin back-office only: Bootstrap 5, Remix Icon,
    #     SweetAlert2, TinyMCE 6 — see templates/layouts/admin.twig)
    #   - Google Analytics (gtag.js, public side only; injected by base.twig
    #     when site.google_analytics_id is set in /admin/settings)
    # makueniyouth.org is intentionally NOT in the allow-list: the legacy WP
    # site is being decommissioned and all content has been rehosted locally.
    Header set Content-Security-Policy "default-src 'self'; \
        script-src 'self' 'unsafe-inline' https://js.paystack.co https://cdn.jsdelivr.net https://www.googletagmanager.com; \
        style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; \
        font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net data:; \
        img-src 'self' data: blob: https://*.paystack.co https://*.google-analytics.com https://*.googletagmanager.com; \
        connect-src 'self' https://api.paystack.co https://cdn.jsdelivr.net https://*.google-analytics.com https://*.googletagmanager.com; \
        frame-src 'self' https://checkout.paystack.com; \
        worker-src 'self' blob:; \
        child-src 'self' blob:; \
        form-action 'self' https://checkout.paystack.com; \
        frame-ancestors 'self'; \
        base-uri 'self'; \
        object-src 'none'; \
        upgrade-insecure-requests"

    # HSTS only when we are already on HTTPS, never plain HTTP.
    <If "%{HTTPS} == 'on'">
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    </If>
</IfModule>

# Disable directory listing
Options -Indexes -MultiViews

# -------------------------------------------------------------------------
# MIME types Apache may not know about by default.
# ImageProcessor stores uploads as .webp (preferred) and falls back to .jpg
# when libwebp isn't compiled into GD. Some cPanel hosts ship an Apache
# build without webp / avif in mime.types, which then sends the files as
# application/octet-stream and the browser refuses to render them because
# X-Content-Type-Options: nosniff is set above.
# -------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType image/webp  .webp
    AddType image/avif  .avif
    AddType image/svg+xml .svg .svgz
    AddType font/woff2  .woff2
    AddType font/woff   .woff
</IfModule>

# -------------------------------------------------------------------------
# Gzip (M7.3)
# -------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# -------------------------------------------------------------------------
# Static asset cache (M7.3)
# -------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg     "access plus 30 days"
    ExpiresByType image/png      "access plus 30 days"
    ExpiresByType image/webp     "access plus 30 days"
    ExpiresByType image/svg+xml  "access plus 30 days"
    ExpiresByType text/css       "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType font/woff2     "access plus 365 days"
</IfModule>

# =========================================================================
# 301 redirects from the legacy WordPress site (M6.2)
# Map authoritative source: database/redirects.md
# =========================================================================

# Block sensitive WP endpoints outright
RedirectMatch 403 ^/wp-admin($|/.*)
RedirectMatch 403 ^/wp-login\.php$
RedirectMatch 403 ^/xmlrpc\.php$
RedirectMatch 410 ^/feed/?$
RedirectMatch 410 ^/feed/(rss|atom|rdf)/?$

# Section / program pages
Redirect 301 /advocacy-civic-education/        /programs/advocacy-civic-engagement
Redirect 301 /advocacy-civic-engagement/       /programs/advocacy-civic-engagement
Redirect 301 /leadership-talent/               /programs/leadership-talent-development
Redirect 301 /leadership-talent-development/   /programs/leadership-talent-development
Redirect 301 /education-capacity/              /programs/education-capacity-enhancement
Redirect 301 /education-capacity-enhancement/  /programs/education-capacity-enhancement
Redirect 301 /foundational-literacy-numeracy/  /programs/foundational-literacy-numeracy-assessment
Redirect 301 /youth-mentorship/                /programs/youth-mentorship

# Static pages
Redirect 301 /about-us/    /about
Redirect 301 /contact-us/  /contact
Redirect 301 /donate-now/  /donate

# Blog / archive landing pages
Redirect 301 /blog/        /impact
Redirect 301 /news/        /impact

# Category / tag / author archives -> /impact list
RedirectMatch 301 ^/category/.*$ /impact
RedirectMatch 301 ^/tag/.*$      /impact
RedirectMatch 301 ^/author/.*$   /impact

# Dated post permalinks  /YYYY/MM/DD/{slug}/  ->  /impact/{slug}
RedirectMatch 301 ^/[0-9]{4}/[0-9]{2}/[0-9]{2}/([^/]+)/?$ /impact/$1
# Two-segment date  /YYYY/MM/{slug}/         ->  /impact/{slug}
RedirectMatch 301 ^/[0-9]{4}/[0-9]{2}/([^/]+)/?$ /impact/$1

# =========================================================================
# Front controller
# =========================================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# Block direct access to dotfiles
RewriteRule (^|/)\. - [F]

# =========================================================================
# Lock down /uploads — never serve executables, even if smuggled in.
# This is belt-and-braces: ImageProcessor already validates extension +
# MIME and renames the file to a random hex name, but a misconfigured
# host or a future bug shouldn't be able to execute anything from here.
# =========================================================================
<Directory "uploads">
    <FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|phar|pl|py|cgi|asp|aspx|jsp|sh|bash|exe|dll|htaccess|htpasswd)$">
        Require all denied
    </FilesMatch>
    php_flag engine off
    Options -ExecCGI -Indexes
    AddType text/plain .html .htm .shtml
</Directory>
