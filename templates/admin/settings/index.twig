{% extends 'layouts/admin.twig' %}

{% block title %}Site settings{% endblock %}
{% block subtitle %}<div class="subtitle">These values appear in the public header and footer.</div>{% endblock %}

{% block content %}
<form method="post" action="/admin/settings" class="admin-form">
  {{ csrf_field()|raw }}
  <div class="panel">
    <div class="field-row">
      <div class="field"><label for="name">Site name</label><input type="text" id="name" name="name" value="{{ settings.name|default('') }}"></div>
      <div class="field"><label for="tagline">Tagline</label><input type="text" id="tagline" name="tagline" value="{{ settings.tagline|default('') }}"></div>
    </div>
    <div class="field-row" style="margin-top:16px">
      <div class="field"><label for="phone">Phone</label><input type="tel" id="phone" name="phone" value="{{ settings.phone|default('') }}"></div>
      <div class="field"><label for="email">Email</label><input type="email" id="email" name="email" value="{{ settings.email|default('') }}"></div>
    </div>
    <div class="field" style="margin-top:16px">
      <label for="address">Address</label>
      <input type="text" id="address" name="address" value="{{ settings.address|default('') }}">
    </div>
    <div class="field" style="margin-top:16px">
      <label for="po_box">P.O. Box</label>
      <input type="text" id="po_box" name="po_box" value="{{ settings.po_box|default('') }}">
    </div>
  </div>

  <div class="panel">
    <h3 style="font-family:'Fraunces',serif;font-size:1.1rem;margin:0 0 12px">Social links</h3>
    <div class="field-row">
      <div class="field"><label for="facebook">Facebook</label><input type="url" id="facebook" name="facebook" value="{{ settings.facebook|default('') }}"></div>
      <div class="field"><label for="twitter">X / Twitter</label><input type="url" id="twitter" name="twitter" value="{{ settings.twitter|default('') }}"></div>
    </div>
    <div class="field" style="margin-top:16px">
      <label for="linkedin">LinkedIn</label>
      <input type="url" id="linkedin" name="linkedin" value="{{ settings.linkedin|default('') }}">
    </div>
  </div>

  <div class="actions">
    <button type="submit" class="admin-btn primary">Save settings</button>
  </div>
</form>
{% endblock %}
