{% extends 'layouts/admin.twig' %}
{% import 'admin/_partials/_form_helpers.twig' as h %}

{% block title %}Volunteers{% endblock %}

{% block breadcrumb %}
  {{ h.breadcrumbs([{label: 'Dashboard', href: '/admin'}, {label: 'Volunteers'}]) }}
{% endblock %}

{% block actions %}
  <a href="/admin/volunteers/export.csv" class="btn btn-primary">
    <i class="ri ri-download-2-line"></i> Export CSV
  </a>
{% endblock %}

{% block content %}
<div class="admin-table-card">
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Interest</th>
          <th>Received</th>
        </tr>
      </thead>
      <tbody>
        {% for v in volunteers %}
          <tr>
            <td>
              <div class="fw-semibold">{{ v.full_name }}</div>
              {% if v.message %}
                <div class="text-muted small" style="max-width:380px">{{ v.message|slice(0,160) }}{{ v.message|length > 160 ? '…' : '' }}</div>
              {% endif %}
            </td>
            <td><a href="mailto:{{ v.email }}" class="text-decoration-none small"><i class="ri ri-mail-line"></i> {{ v.email }}</a></td>
            <td>{% if v.phone %}<a href="tel:{{ v.phone }}" class="text-decoration-none small"><i class="ri ri-phone-line"></i> {{ v.phone }}</a>{% else %}<span class="text-muted">—</span>{% endif %}</td>
            <td>{{ v.interest|default('—') }}</td>
            <td><span class="text-muted small">{{ v.created_at|date('M j, Y') }}</span></td>
          </tr>
        {% else %}
          <tr><td colspan="5" class="text-center text-muted py-5">
            <i class="ri ri-user-add-line d-block fs-1 opacity-25 mb-2"></i>
            No volunteer applications yet.
          </td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
