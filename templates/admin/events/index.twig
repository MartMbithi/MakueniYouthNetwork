{% extends 'layouts/admin.twig' %}
{% import 'admin/_partials/_form_helpers.twig' as h %}

{% block title %}Events{% endblock %}

{% block breadcrumb %}
  {{ h.breadcrumbs([{label: 'Dashboard', href: '/admin'}, {label: 'Events'}]) }}
{% endblock %}

{% block actions %}
  <a href="/admin/events/create" class="btn btn-primary"><i class="ri ri-add-line"></i> New event</a>
{% endblock %}

{% block content %}
<div class="admin-table-card">
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead>
        <tr>
          <th>Title</th>
          <th>When</th>
          <th>Venue</th>
          <th>Status</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for e in events %}
          <tr>
            <td><a href="/admin/events/{{ e.id }}/edit" class="fw-semibold text-decoration-none">{{ e.title }}</a></td>
            <td><i class="ri ri-calendar-event-line text-muted me-1"></i> {{ e.starts_at|date('M j, Y · g:ia') }}</td>
            <td>{{ e.venue|default('—') }}</td>
            <td>{{ h.status_pill(e.status) }}</td>
            <td class="text-end">
              <div class="row-actions justify-content-end">
                <a class="btn btn-sm btn-outline-secondary" href="/events/{{ e.slug }}" target="_blank" rel="noopener" title="View live"><i class="ri ri-eye-line"></i></a>
                <a class="btn btn-sm btn-outline-primary" href="/admin/events/{{ e.id }}/edit" title="Edit"><i class="ri ri-pencil-line"></i></a>
                {{ h.delete_button('/admin/events/' ~ e.id ~ '/delete', {icon_only: true, title: 'Delete this event?', text: 'The event "' ~ e.title ~ '" will be permanently removed.'}) }}
              </div>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="5" class="text-center text-muted py-5">
            <i class="ri ri-calendar-event-line d-block fs-1 opacity-25 mb-2"></i>
            No events yet.
          </td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
