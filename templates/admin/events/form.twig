{% extends 'layouts/admin.twig' %}
{% import 'admin/_partials/_form_helpers.twig' as h %}

{% block title %}{{ mode == 'create' ? 'New event' : 'Edit event' }}{% endblock %}

{% block content %}
{{ h.errors(errors|default([])) }}

<form method="post" action="{{ action }}" enctype="multipart/form-data" class="admin-form">
  {{ csrf_field()|raw }}
  <div class="panel">
    <div class="field">
      <label for="title">Title</label>
      <input type="text" id="title" name="title" value="{{ event.title|default('') }}" required>
    </div>

    <div class="field-row" style="margin-top:16px">
      <div class="field">
        <label for="slug">Slug</label>
        <input type="text" id="slug" name="slug" value="{{ event.slug|default('') }}" placeholder="auto from title">
      </div>
      <div class="field">
        <label for="venue">Venue</label>
        <input type="text" id="venue" name="venue" value="{{ event.venue|default('') }}">
      </div>
    </div>

    <div class="field-row" style="margin-top:16px">
      <div class="field">
        <label for="starts_at">Starts at</label>
        <input type="datetime-local" id="starts_at" name="starts_at" value="{{ event.starts_at ? event.starts_at|date('Y-m-d\\TH:i') : '' }}" required>
      </div>
      <div class="field">
        <label for="ends_at">Ends at (optional)</label>
        <input type="datetime-local" id="ends_at" name="ends_at" value="{{ event.ends_at ? event.ends_at|date('Y-m-d\\TH:i') : '' }}">
      </div>
    </div>

    <div class="field" style="margin-top:16px">
      <label for="description">Description (HTML)</label>
      <textarea id="description" name="description">{{ event.description|default('') }}</textarea>
    </div>

    <div class="field-row" style="margin-top:16px">
      <div class="field">
        <label for="cover_image">Cover image URL</label>
        <input type="url" id="cover_image" name="cover_image" value="{{ event.cover_image|default('') }}">
      </div>
      <div class="field">
        <label for="cover_image_file">…or upload</label>
        <input type="file" id="cover_image_file" name="cover_image_file" accept="image/jpeg,image/png,image/webp">
      </div>
    </div>
  </div>

  <div class="actions">
    <button type="submit" name="action" value="draft"   class="admin-btn ghost">Save draft</button>
    <button type="submit" name="action" value="publish" class="admin-btn primary">{{ event.status == 'published' ? 'Update' : 'Publish' }}</button>
    {% if event.id %}
      <a href="/events/{{ event.slug }}" target="_blank" class="admin-btn amber">View live →</a>
      <span style="flex:1"></span>
      {{ h.delete_button('/admin/events/' ~ event.id ~ '/delete') }}
    {% endif %}
  </div>
</form>
{% endblock %}
