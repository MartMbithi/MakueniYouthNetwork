{% extends 'layouts/admin.twig' %}
{% import 'admin/_partials/_form_helpers.twig' as h %}

{% block title %}{{ mode == 'create' ? 'New event' : 'Edit event' }}{% endblock %}

{% block breadcrumb %}
  {{ h.breadcrumbs([
    {label: 'Dashboard', href: '/admin'},
    {label: 'Events',    href: '/admin/events'},
    {label: mode == 'create' ? 'New' : (event.title|default('Edit'))}
  ]) }}
{% endblock %}

{% block actions %}
  {% if event.id %}
    <a href="/events/{{ event.slug }}" target="_blank" rel="noopener" class="btn btn-outline-secondary">
      <i class="ri ri-eye-line"></i> View live
    </a>
  {% endif %}
{% endblock %}

{% block content %}
{{ h.errors(errors|default([])) }}

<form method="post" action="{{ action }}" enctype="multipart/form-data" novalidate>
  {{ csrf_field()|raw }}

  <div class="row g-4">
    <div class="col-lg-8">
      {{ h.card_open('Event details', 'calendar-event-line') }}
        {{ h.text('title', 'Title', event.title|default(''), {required: true, errors: errors|default([])}) }}
        <div class="row g-3">
          <div class="col-md-6">{{ h.text('slug', 'Slug', event.slug|default(''), {placeholder: 'auto from title', errors: errors|default([])}) }}</div>
          <div class="col-md-6">{{ h.text('venue', 'Venue', event.venue|default(''), {placeholder: 'e.g. Famo House Hall', errors: errors|default([])}) }}</div>
        </div>
        <div class="row g-3">
          <div class="col-md-6">{{ h.text('starts_at', 'Starts at', event.starts_at ? event.starts_at|date('Y-m-d\\TH:i') : '', {type: 'datetime-local', required: true, errors: errors|default([])}) }}</div>
          <div class="col-md-6">{{ h.text('ends_at', 'Ends at', event.ends_at ? event.ends_at|date('Y-m-d\\TH:i') : '', {type: 'datetime-local', help: 'Optional.', errors: errors|default([])}) }}</div>
        </div>
        {{ h.richtext('description', 'Description', event.description|default(''), {errors: errors|default([])}) }}
      {{ h.card_close() }}
    </div>

    <div class="col-lg-4">
      {{ h.card_open('Publish', 'send-plane-line') }}
        <div class="d-grid gap-2">
          <button type="submit" name="action" value="publish" class="btn btn-primary">
            <i class="ri ri-global-line"></i> {{ event.status == 'published' ? 'Update event' : 'Publish' }}
          </button>
          <button type="submit" name="action" value="draft" class="btn btn-outline-secondary">
            <i class="ri ri-draft-line"></i> Save as draft
          </button>
        </div>
      {{ h.card_close() }}

      {{ h.card_open('Cover image', 'image-line') }}
        {{ h.image_upload('cover_image', 'Featured image', event.cover_image|default(null), {help: 'Used at the top of the event page and on cards.', errors: errors|default([])}) }}
      {{ h.card_close() }}

      {% if event.id %}
        {{ h.card_open('Danger zone', 'shield-cross-line', 'border border-danger-subtle') }}
          {{ h.delete_button('/admin/events/' ~ event.id ~ '/delete', {label: 'Delete event', title: 'Delete this event?', text: 'The event "' ~ event.title ~ '" will be permanently removed.'}) }}
        {{ h.card_close() }}
      {% endif %}
    </div>
  </div>
</form>
{% endblock %}

{% block scripts_extra %}
<script src="https://cdn.jsdelivr.net/npm/tinymce@6/tinymce.min.js" referrerpolicy="origin"></script>
{% endblock %}
