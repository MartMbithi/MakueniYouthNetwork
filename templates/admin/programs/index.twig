{% extends 'layouts/admin.twig' %}
{% import 'admin/_partials/_form_helpers.twig' as h %}

{% block title %}Programs{% endblock %}

{% block breadcrumb %}
  {{ h.breadcrumbs([{label: 'Dashboard', href: '/admin'}, {label: 'Programs'}]) }}
{% endblock %}

{% block actions %}
  <a href="/admin/programs/create" class="btn btn-primary"><i class="ri ri-add-line"></i> New program</a>
{% endblock %}

{% block content %}
<div class="admin-table-card">
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead>
        <tr>
          <th>Title</th>
          <th>URL</th>
          <th>Parent</th>
          <th>Status</th>
          <th>Order</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for p in programs %}
          <tr>
            <td><a href="/admin/programs/{{ p.id }}/edit" class="fw-semibold text-decoration-none">{{ p.title }}</a></td>
            <td><code class="text-mono">/programs/{{ p.slug }}</code></td>
            <td><span class="text-muted small">{{ p.parent_id ? '#' ~ p.parent_id : '—' }}</span></td>
            <td>{{ h.status_pill(p.status) }}</td>
            <td><span class="badge bg-light text-dark border">{{ p.sort_order }}</span></td>
            <td class="text-end">
              <div class="row-actions justify-content-end">
                <a class="btn btn-sm btn-outline-secondary" href="/programs/{{ p.slug }}" target="_blank" rel="noopener" title="View live"><i class="ri ri-eye-line"></i></a>
                <a class="btn btn-sm btn-outline-primary" href="/admin/programs/{{ p.id }}/edit" title="Edit"><i class="ri ri-pencil-line"></i></a>
                {{ h.delete_button('/admin/programs/' ~ p.id ~ '/delete', {icon_only: true, title: 'Delete this program?', text: 'The program "' ~ p.title ~ '" will be permanently removed.'}) }}
              </div>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="6" class="text-center text-muted py-5">
            <i class="ri ri-organization-chart d-block fs-1 opacity-25 mb-2"></i>
            No programs yet.
          </td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
