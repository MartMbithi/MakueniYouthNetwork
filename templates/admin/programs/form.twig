{% extends 'layouts/admin.twig' %}
{% import 'admin/_partials/_form_helpers.twig' as h %}

{% block title %}{{ mode == 'create' ? 'New program' : 'Edit program' }}{% endblock %}

{% block breadcrumb %}
  {{ h.breadcrumbs([
    {label: 'Dashboard', href: '/admin'},
    {label: 'Programs',  href: '/admin/programs'},
    {label: mode == 'create' ? 'New' : (program.title|default('Edit'))}
  ]) }}
{% endblock %}

{% block actions %}
  {% if program.id %}
    <a href="/programs/{{ program.slug }}" target="_blank" rel="noopener" class="btn btn-outline-secondary">
      <i class="ri ri-eye-line"></i> View live
    </a>
  {% endif %}
{% endblock %}

{% block content %}
{{ h.errors(errors|default([])) }}

<form method="post" action="{{ action }}" enctype="multipart/form-data" novalidate>
  {{ csrf_field()|raw }}

  <div class="row g-4">
    <div class="col-lg-8">
      {{ h.card_open('Program details', 'organization-chart') }}
        {{ h.text('title', 'Title', program.title|default(''), {required: true, errors: errors|default([])}) }}
        {{ h.text('slug',  'Slug',  program.slug|default(''),  {placeholder: 'auto from title', help: 'URL: <code>/programs/' ~ (program.slug|default('your-slug')) ~ '</code>', errors: errors|default([])}) }}
        {{ h.textarea('summary', 'Summary', program.summary|default(''), {rows: 3, help: 'Shown on the homepage card and in lists.', errors: errors|default([])}) }}
        {{ h.richtext('body', 'Body', program.body|default(''), {errors: errors|default([])}) }}
      {{ h.card_close() }}
    </div>

    <div class="col-lg-4">
      {{ h.card_open('Publish', 'send-plane-line') }}
        {% set status_options = [{value: 'published', label: 'Published'}, {value: 'draft', label: 'Draft'}] %}
        {{ h.select('status', 'Status', status_options, program.status|default('published'), {errors: errors|default([])}) }}
        <div class="d-grid">
          <button type="submit" name="action" value="save" class="btn btn-primary">
            <i class="ri ri-checkbox-circle-line"></i> {{ mode == 'create' ? 'Create program' : 'Save changes' }}
          </button>
        </div>
      {{ h.card_close() }}

      {{ h.card_open('Hierarchy', 'node-tree') }}
        {% set parent_options = [] %}
        {% for p in parents %}{% set parent_options = parent_options|merge([{value: p.id, label: p.title}]) %}{% endfor %}
        {{ h.select('parent_id', 'Parent program', parent_options, program.parent_id|default(null), {blank: '— top level —', help: 'Pick a parent to make this a sub-program.', errors: errors|default([])}) }}
        {{ h.text('sort_order', 'Display order', program.sort_order|default(0), {type: 'number', help: 'Lower numbers appear first.', errors: errors|default([])}) }}
      {{ h.card_close() }}

      {{ h.card_open('Cover image', 'image-line') }}
        {{ h.image_upload('cover_image', 'Featured image', program.cover_image|default(null), {help: 'Used on the program landing page and on the homepage card.', errors: errors|default([])}) }}
      {{ h.card_close() }}

      {% if program.id %}
        {{ h.card_open('Danger zone', 'shield-cross-line', 'border border-danger-subtle') }}
          <p class="text-muted small mb-3">Deleting a program removes it from all menus.</p>
          {{ h.delete_button('/admin/programs/' ~ program.id ~ '/delete', {label: 'Delete program', title: 'Delete this program?', text: 'The program "' ~ program.title ~ '" will be permanently removed.'}) }}
        {{ h.card_close() }}
      {% endif %}
    </div>
  </div>
</form>
{% endblock %}

{% block scripts_extra %}
<script src="https://cdn.jsdelivr.net/npm/tinymce@6/tinymce.min.js" referrerpolicy="origin"></script>
{% endblock %}
