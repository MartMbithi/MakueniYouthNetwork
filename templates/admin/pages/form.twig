{% extends 'layouts/admin.twig' %}
{% import 'admin/_partials/_form_helpers.twig' as h %}

{% block title %}{{ mode == 'create' ? 'New page' : 'Edit page' }}{% endblock %}

{% block breadcrumb %}
  {{ h.breadcrumbs([
    {label: 'Dashboard', href: '/admin'},
    {label: 'Pages',     href: '/admin/pages'},
    {label: mode == 'create' ? 'New' : (page.title|default('Edit'))}
  ]) }}
{% endblock %}

{% block actions %}
  {% if page.id %}
    <a href="/{{ page.slug }}" target="_blank" rel="noopener" class="btn btn-outline-secondary">
      <i class="ri ri-eye-line"></i> View live
    </a>
  {% endif %}
{% endblock %}

{% block content %}
{{ h.errors(errors|default([])) }}

<form method="post" action="{{ action }}" enctype="multipart/form-data" novalidate>
  {{ csrf_field()|raw }}

  <div class="row g-4">
    <div class="col-lg-8">
      {{ h.card_open('Page content', 'file-text-line') }}
        {{ h.text('title', 'Title', page.title|default(''), {required: true, errors: errors|default([])}) }}
        {{ h.text('slug',  'Slug',  page.slug|default(''),  {placeholder: 'auto from title', help: 'URL: <code>/' ~ (page.slug|default('your-slug')) ~ '</code>', errors: errors|default([])}) }}
        {{ h.textarea('meta_desc', 'Meta description (SEO)', page.meta_desc|default(''), {rows: 3, help: '~150 characters. Shown in Google results and share previews.', errors: errors|default([])}) }}
        {{ h.richtext('body', 'Body', page.body|default(''), {required: true, errors: errors|default([])}) }}
      {{ h.card_close() }}
    </div>

    <div class="col-lg-4">
      {{ h.card_open('Publish', 'send-plane-line') }}
        <div class="d-grid gap-2">
          <button type="submit" name="action" value="publish" class="btn btn-primary">
            <i class="ri ri-global-line"></i> {{ page.status == 'published' ? 'Update page' : 'Publish' }}
          </button>
          <button type="submit" name="action" value="draft" class="btn btn-outline-secondary">
            <i class="ri ri-draft-line"></i> Save as draft
          </button>
        </div>
      {{ h.card_close() }}

      {{ h.card_open('Hero image', 'image-line') }}
        {{ h.image_upload('hero_image', 'Hero image', page.hero_image|default(null), {help: 'Top-of-page image used as the section header.', errors: errors|default([])}) }}
      {{ h.card_close() }}

      {% if page.id %}
        {{ h.card_open('Danger zone', 'shield-cross-line', 'border border-danger-subtle') }}
          {{ h.delete_button('/admin/pages/' ~ page.id ~ '/delete', {label: 'Delete page', title: 'Delete this page?', text: 'The page "' ~ page.title ~ '" will be permanently removed.'}) }}
        {{ h.card_close() }}
      {% endif %}
    </div>
  </div>
</form>
{% endblock %}

{% block scripts_extra %}
<script src="https://cdn.jsdelivr.net/npm/tinymce@6/tinymce.min.js" referrerpolicy="origin"></script>
{% endblock %}
