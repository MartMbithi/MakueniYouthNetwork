{% extends 'layouts/admin.twig' %}
{% import 'admin/_partials/_form_helpers.twig' as h %}

{% block title %}Pages{% endblock %}

{% block breadcrumb %}
  {{ h.breadcrumbs([{label: 'Dashboard', href: '/admin'}, {label: 'Pages'}]) }}
{% endblock %}

{% block actions %}
  <a href="/admin/pages/create" class="btn btn-primary"><i class="ri ri-add-line"></i> New page</a>
{% endblock %}

{% block content %}
<div class="admin-table-card">
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead>
        <tr>
          <th>Title</th>
          <th>URL</th>
          <th>Status</th>
          <th>Updated</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for p in pages %}
          <tr>
            <td><a href="/admin/pages/{{ p.id }}/edit" class="fw-semibold text-decoration-none">{{ p.title }}</a></td>
            <td><code class="text-mono">/{{ p.slug }}</code></td>
            <td>{{ h.status_pill(p.status) }}</td>
            <td><span class="text-muted small">{{ p.updated_at|date('M j, Y') }}</span></td>
            <td class="text-end">
              <div class="row-actions justify-content-end">
                <a class="btn btn-sm btn-outline-secondary" href="/{{ p.slug }}" target="_blank" rel="noopener" title="View live"><i class="ri ri-eye-line"></i></a>
                <a class="btn btn-sm btn-outline-primary" href="/admin/pages/{{ p.id }}/edit" title="Edit"><i class="ri ri-pencil-line"></i></a>
                {{ h.delete_button('/admin/pages/' ~ p.id ~ '/delete', {icon_only: true, title: 'Delete this page?', text: 'The page "' ~ p.title ~ '" will be permanently removed.'}) }}
              </div>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="5" class="text-center text-muted py-5">
            <i class="ri ri-file-text-line d-block fs-1 opacity-25 mb-2"></i>
            No pages yet.
          </td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
