{% extends 'layouts/admin.twig' %}

{% block title %}{{ mode == 'create' ? 'New partner' : 'Edit partner' }}{% endblock %}

{% block content %}
<form method="post" action="{{ action }}" enctype="multipart/form-data" class="admin-form">
  {{ csrf_field()|raw }}
  <div class="panel">
    <div class="field">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" value="{{ partner.name|default('') }}" required>
    </div>
    <div class="field" style="margin-top:16px">
      <label for="url">URL</label>
      <input type="url" id="url" name="url" value="{{ partner.url|default('') }}">
    </div>
    <div class="field-row" style="margin-top:16px">
      <div class="field">
        <label for="logo">Logo URL</label>
        <input type="url" id="logo" name="logo" value="{{ partner.logo|default('') }}">
        {% if partner.logo %}<div class="help"><img src="{{ partner.logo }}" alt="" style="max-height:48px;margin-top:6px"></div>{% endif %}
      </div>
      <div class="field">
        <label for="logo_file">…or upload</label>
        <input type="file" id="logo_file" name="logo_file" accept="image/jpeg,image/png,image/webp">
      </div>
    </div>
    <div class="field" style="margin-top:16px">
      <label for="sort_order">Display order</label>
      <input type="number" id="sort_order" name="sort_order" value="{{ partner.sort_order|default(0) }}">
    </div>
  </div>

  <div class="actions">
    <button type="submit" class="admin-btn primary">{{ mode == 'create' ? 'Create' : 'Save' }}</button>
    <a href="/admin/partners" class="admin-btn ghost">Cancel</a>
  </div>
</form>
{% endblock %}
