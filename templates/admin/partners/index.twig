{% extends 'layouts/admin.twig' %}
{% import 'admin/_partials/_form_helpers.twig' as h %}

{% block title %}Partners{% endblock %}

{% block breadcrumb %}
  {{ h.breadcrumbs([{label: 'Dashboard', href: '/admin'}, {label: 'Partners'}]) }}
{% endblock %}

{% block actions %}
  <a href="/admin/partners/create" class="btn btn-primary"><i class="ri ri-add-line"></i> New partner</a>
{% endblock %}

{% block content %}
<div class="admin-table-card">
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead>
        <tr>
          <th style="width:80px">Logo</th>
          <th>Name</th>
          <th>Website</th>
          <th>Order</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for p in partners %}
          <tr>
            <td>
              {% if p.logo %}
                <img src="{{ p.logo }}" alt="" class="rounded border bg-light p-1" style="width:48px;height:48px;object-fit:contain;">
              {% else %}
                <div class="rounded border d-grid place-items-center text-muted" style="width:48px;height:48px"><i class="ri ri-image-line"></i></div>
              {% endif %}
            </td>
            <td><a href="/admin/partners/{{ p.id }}/edit" class="fw-semibold text-decoration-none">{{ p.name }}</a></td>
            <td>
              {% if p.url %}
                <a href="{{ p.url }}" target="_blank" rel="noopener" class="text-decoration-none small">
                  <i class="ri ri-external-link-line"></i> {{ p.url|slice(0,40) }}{{ p.url|length > 40 ? '…' : '' }}
                </a>
              {% else %}
                <span class="text-muted">—</span>
              {% endif %}
            </td>
            <td><span class="badge bg-light text-dark border">{{ p.sort_order }}</span></td>
            <td class="text-end">
              <div class="row-actions justify-content-end">
                <a class="btn btn-sm btn-outline-primary" href="/admin/partners/{{ p.id }}/edit" title="Edit"><i class="ri ri-pencil-line"></i></a>
                {{ h.delete_button('/admin/partners/' ~ p.id ~ '/delete', {icon_only: true, title: 'Delete this partner?', text: 'The partner "' ~ p.name ~ '" will be permanently removed.'}) }}
              </div>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="5" class="text-center text-muted py-5">
            <i class="ri ri-team-line d-block fs-1 opacity-25 mb-2"></i>
            No partners yet.
          </td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
