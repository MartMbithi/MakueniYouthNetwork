{% extends 'layouts/admin.twig' %}{% import 'admin/_partials/_form_helpers.twig' as h %}{% block title %}FAQs{% endblock %}{% block actions %}<a href="/admin/faqs/create" class="btn btn-primary">New FAQ</a>{% endblock %}
{% block content %}<div class="admin-table-card"><div class="table-responsive"><table class="table"><thead><tr><th>Question</th><th>Category</th><th>Status</th><th>Order</th><th class="text-end">Actions</th></tr></thead><tbody>{% for f in faqs %}<tr><td>{{ f.question }}</td><td>{{ f.category|default('—') }}</td><td>{{ h.status_pill(f.status) }}</td><td>{{ f.sort_order }}</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/admin/faqs/{{ f.id }}/edit">Edit</a> {{ h.delete_button('/admin/faqs/' ~ f.id ~ '/delete',{icon_only:true,title:'Delete FAQ?',text:'This FAQ will be permanently removed.'}) }}</td></tr>{% else %}<tr><td colspan="5" class="text-center py-5">No FAQs yet.</td></tr>{% endfor %}</tbody></table></div></div>{% endblock %}
