{% extends 'layouts/admin.twig' %}{% block title %}{{ faq ? 'Edit FAQ' : 'New FAQ' }}{% endblock %}{% block content %}<form method="post" action="{{ action }}" class="admin-form-card">{{ csrf_field()|raw }}<div class="row g-3"><div class="col-12"><label class="form-label">Question</label><input required name="question" class="form-control" value="{{ faq.question|default('') }}"></div><div class="col-12"><label class="form-label">Answer</label><textarea required name="answer" rows="7" class="form-control">{{ faq.answer|default('') }}</textarea></div><div class="col-md-5"><label class="form-label">Category</label><input name="category" class="form-control" value="{{ faq.category|default('') }}"></div><div class="col-md-3"><label class="form-label">Order</label><input type="number" name="sort_order" class="form-control" value="{{ faq.sort_order|default(0) }}"></div><div class="col-md-4"><label class="form-label">Status</label><select name="status" class="form-select"><option value="published">Published</option><option value="draft" {{ faq.status|default('') == 'draft' ? 'selected' }}>Draft</option></select></div><div class="col-12"><button class="btn btn-primary">Save FAQ</button></div></div></form>{% endblock %}
