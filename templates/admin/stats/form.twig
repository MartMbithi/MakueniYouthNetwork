{% extends 'layouts/admin.twig' %}
{% import 'admin/_partials/_form_helpers.twig' as h %}

{% block title %}{{ mode == 'create' ? 'New stat' : 'Edit stat' }}{% endblock %}

{% block breadcrumb %}
  {{ h.breadcrumbs([
    {label: 'Dashboard', href: '/admin'},
    {label: 'Stats',     href: '/admin/stats'},
    {label: mode == 'create' ? 'New' : (stat.label|default('Edit'))}
  ]) }}
{% endblock %}

{% block content %}
<form method="post" action="{{ action }}" novalidate>
  {{ csrf_field()|raw }}

  <div class="row g-4">
    <div class="col-lg-8">
      {{ h.card_open('Stat', 'bar-chart-line') }}
        <div class="row g-3">
          <div class="col-md-6">{{ h.text('value', 'Value', stat.value|default(''), {required: true, placeholder: '500+', help: 'Whatever appears as the headline number.'}) }}</div>
          <div class="col-md-6">{{ h.text('sort_order', 'Display order', stat.sort_order|default(0), {type: 'number'}) }}</div>
        </div>
        {{ h.text('label', 'Label', stat.label|default(''), {required: true, placeholder: 'Youth trained'}) }}
      {{ h.card_close() }}
    </div>

    <div class="col-lg-4">
      {{ h.card_open('Save', 'checkbox-circle-line') }}
        <div class="d-grid gap-2">
          <button type="submit" class="btn btn-primary">
            <i class="ri ri-checkbox-circle-line"></i> {{ mode == 'create' ? 'Create stat' : 'Save changes' }}
          </button>
          <a href="/admin/stats" class="btn btn-outline-secondary">Cancel</a>
        </div>
      {{ h.card_close() }}
    </div>
  </div>
</form>
{% endblock %}
