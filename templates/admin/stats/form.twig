{% extends 'layouts/admin.twig' %}

{% block title %}{{ mode == 'create' ? 'New stat' : 'Edit stat' }}{% endblock %}

{% block content %}
<form method="post" action="{{ action }}" class="admin-form">
  {{ csrf_field()|raw }}
  <div class="panel">
    <div class="field-row">
      <div class="field">
        <label for="value">Value</label>
        <input type="text" id="value" name="value" value="{{ stat.value|default('') }}" required>
      </div>
      <div class="field">
        <label for="sort_order">Display order</label>
        <input type="number" id="sort_order" name="sort_order" value="{{ stat.sort_order|default(0) }}">
      </div>
    </div>
    <div class="field" style="margin-top:16px">
      <label for="label">Label</label>
      <input type="text" id="label" name="label" value="{{ stat.label|default('') }}" required>
    </div>
  </div>

  <div class="actions">
    <button type="submit" class="admin-btn primary">{{ mode == 'create' ? 'Create' : 'Save' }}</button>
    <a href="/admin/stats" class="admin-btn ghost">Cancel</a>
  </div>
</form>
{% endblock %}
