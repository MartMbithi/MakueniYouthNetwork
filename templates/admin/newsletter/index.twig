{% extends 'layouts/admin.twig' %}{% block title %}Newsletter Subscribers{% endblock %}{% block content %}<div class="admin-table-card"><div class="table-responsive"><table class="table"><thead><tr><th>Email</th><th>Name</th><th>Status</th><th>Subscribed</th></tr></thead><tbody>{% for s in subscribers %}<tr><td>{{ s.email }}</td><td>{{ s.name|default('—') }}</td><td>{{ s.status }}</td><td>{{ s.subscribed_at|date('M j, Y H:i') }}</td></tr>{% else %}<tr><td colspan="4" class="text-center py-5">No subscribers yet.</td></tr>{% endfor %}</tbody></table></div></div>{% endblock %}
