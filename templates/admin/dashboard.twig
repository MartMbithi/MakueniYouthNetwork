{% extends 'layouts/admin.twig' %}
{% import 'admin/_partials/_form_helpers.twig' as h %}

{% block title %}Dashboard{% endblock %}

{% block subtitle %}
  <p class="text-muted mb-0 mt-1">Welcome back, <strong>{{ auth.name }}</strong>. Here's a snapshot of the site today.</p>
{% endblock %}

{% block content %}

<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="stat-card">
      <div class="stat-icon"><i class="ri ri-newspaper-line"></i></div>
      <div>
        <span class="n">{{ counts.posts_published }}</span>
        <div class="l">Published posts <span class="text-muted">· {{ counts.posts_total }} total</span></div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="stat-card">
      <div class="stat-icon amber"><i class="ri ri-mail-line"></i></div>
      <div>
        <span class="n">{{ counts.messages_unread }}</span>
        <div class="l">Unread messages</div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="stat-card">
      <div class="stat-icon green"><i class="ri ri-money-dollar-circle-line"></i></div>
      <div>
        <span class="n">{{ counts.donations_pending }}</span>
        <div class="l">Pending donations <span class="text-muted">· {{ counts.donations_completed }} completed</span></div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="stat-card">
      <div class="stat-icon red"><i class="ri ri-calendar-event-line"></i></div>
      <div>
        <span class="n">{{ counts.events_upcoming }}</span>
        <div class="l">Upcoming events</div>
      </div>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-6">
    {{ h.card_open('Latest messages', 'mail-line') }}
      {% if recent.messages|length == 0 %}
        <p class="text-muted small mb-0">No messages yet.</p>
      {% else %}
        <ul class="list-unstyled mb-0">
          {% for m in recent.messages %}
            <li class="d-flex justify-content-between gap-2 py-2 border-bottom">
              <div class="min-w-0">
                <a href="/admin/messages" class="fw-semibold text-decoration-none">{{ m.name }}</a>
                <div class="text-muted small text-truncate">{{ m.subject|default('(no subject)') }}</div>
              </div>
              <small class="text-muted text-nowrap">{{ m.created_at|date('M j') }}</small>
            </li>
          {% endfor %}
        </ul>
        <a href="/admin/messages" class="btn btn-sm btn-link px-0 mt-2">View all <i class="ri ri-arrow-right-line"></i></a>
      {% endif %}
    {{ h.card_close() }}
  </div>

  <div class="col-lg-6">
    {{ h.card_open('Latest volunteers', 'user-add-line') }}
      {% if recent.volunteers|length == 0 %}
        <p class="text-muted small mb-0">No volunteers yet.</p>
      {% else %}
        <ul class="list-unstyled mb-0">
          {% for v in recent.volunteers %}
            <li class="d-flex justify-content-between gap-2 py-2 border-bottom">
              <div class="min-w-0">
                <a href="/admin/volunteers" class="fw-semibold text-decoration-none">{{ v.full_name }}</a>
                <div class="text-muted small text-truncate">{{ v.interest|default('—') }}</div>
              </div>
              <small class="text-muted text-nowrap">{{ v.created_at|date('M j') }}</small>
            </li>
          {% endfor %}
        </ul>
        <a href="/admin/volunteers" class="btn btn-sm btn-link px-0 mt-2">View all <i class="ri ri-arrow-right-line"></i></a>
      {% endif %}
    {{ h.card_close() }}
  </div>

  <div class="col-12">
    {{ h.card_open('Recent posts', 'newspaper-line') }}
      {% if recent.posts|length == 0 %}
        <p class="text-muted small mb-0">No posts yet.</p>
      {% else %}
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th>Title</th>
                <th>Status</th>
                <th>Category</th>
                <th>Published</th>
                <th class="text-end"></th>
              </tr>
            </thead>
            <tbody>
              {% for p in recent.posts %}
                <tr>
                  <td><a href="/admin/posts/{{ p.id }}/edit" class="fw-semibold text-decoration-none">{{ p.title }}</a></td>
                  <td>{{ h.status_pill(p.status) }}</td>
                  <td>{{ p.category_name|default('—') }}</td>
                  <td><span class="text-muted small">{{ p.published_at ? p.published_at|date('M j, Y') : '—' }}</span></td>
                  <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" href="/impact/{{ p.slug }}" target="_blank" rel="noopener" title="View live"><i class="ri ri-eye-line"></i></a>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    {{ h.card_close() }}
  </div>
</div>

{% endblock %}
