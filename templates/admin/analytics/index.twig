{% extends 'layouts/admin.twig' %}{% block title %}Site Analytics{% endblock %}{% block content %}<div class="row g-3 mb-4">{% for key,val in counts %}<div class="col-md-4 col-xl-2"><div class="stat-card"><span class="stat-value">{{ val }}</span><span class="stat-label">{{ key|replace({'_':' '})|title }}</span></div></div>{% endfor %}</div><div class="admin-table-card"><h2 class="h5 p-3 mb-0">Most viewed pages</h2><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Page</th><th>Views</th></tr></thead><tbody>{% for p in top_pages %}<tr><td><code>{{ p.path }}</code></td><td>{{ p.views }}</td></tr>{% else %}<tr><td colspan="2" class="text-center py-5">No page-view data yet.</td></tr>{% endfor %}</tbody></table></div></div>{% endblock %}
