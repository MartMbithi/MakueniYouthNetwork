{% extends 'layouts/admin.twig' %}
{% import 'admin/_partials/_form_helpers.twig' as h %}

{% block title %}{{ mode == 'create' ? 'New user' : 'Edit user' }}{% endblock %}

{% block breadcrumb %}
  {{ h.breadcrumbs([
    {label: 'Dashboard', href: '/admin'},
    {label: 'Users',     href: '/admin/users'},
    {label: mode == 'create' ? 'New' : (user.name|default('Edit'))}
  ]) }}
{% endblock %}

{% block content %}
{{ h.errors(errors|default([])) }}

<form method="post" action="{{ action }}" novalidate>
  {{ csrf_field()|raw }}

  <div class="row g-4">
    <div class="col-lg-8">
      {{ h.card_open('Account', 'id-card-line') }}
        {{ h.text('name',  'Full name', user.name|default(''),  {required: true, autocomplete: 'name', errors: errors|default([])}) }}
        {{ h.text('email', 'Email',     user.email|default(''), {type: 'email', required: true, autocomplete: 'email', errors: errors|default([])}) }}
        {{ h.text('password', mode == 'create' ? 'Password' : 'New password (blank = keep current)', '', {type: 'password', autocomplete: 'new-password', required: mode == 'create', help: 'Minimum 8 characters.', errors: errors|default([])}) }}
      {{ h.card_close() }}
    </div>

    <div class="col-lg-4">
      {{ h.card_open('Role', 'shield-keyhole-line') }}
        {% set role_options = [
          {value: 'editor', label: 'Editor — manages content'},
          {value: 'admin',  label: 'Admin — manages everything including users'}
        ] %}
        {{ h.select('role', 'Role', role_options, user.role|default('editor'), {errors: errors|default([])}) }}
        <div class="d-grid gap-2 mt-2">
          <button type="submit" class="btn btn-primary">
            <i class="ri ri-checkbox-circle-line"></i> {{ mode == 'create' ? 'Create user' : 'Save changes' }}
          </button>
          <a href="/admin/users" class="btn btn-outline-secondary">Cancel</a>
        </div>
      {{ h.card_close() }}
    </div>
  </div>
</form>
{% endblock %}
