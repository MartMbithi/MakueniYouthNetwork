{% extends 'layouts/admin.twig' %}
{% import 'admin/_partials/_form_helpers.twig' as h %}

{% block title %}Users{% endblock %}

{% block breadcrumb %}
  {{ h.breadcrumbs([{label: 'Dashboard', href: '/admin'}, {label: 'Users'}]) }}
{% endblock %}

{% block actions %}
  <a href="/admin/users/create" class="btn btn-primary"><i class="ri ri-add-line"></i> New user</a>
{% endblock %}

{% block content %}
<div class="admin-table-card">
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Joined</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for u in users %}
          <tr>
            <td>
              <div class="d-flex align-items-center gap-2">
                <span class="rounded-circle bg-primary-subtle text-primary-emphasis d-grid place-items-center" style="width:36px;height:36px;font-weight:700">{{ u.name|first|upper }}</span>
                <a href="/admin/users/{{ u.id }}/edit" class="fw-semibold text-decoration-none">{{ u.name }}</a>
              </div>
            </td>
            <td><a href="mailto:{{ u.email }}" class="text-muted small text-decoration-none">{{ u.email }}</a></td>
            <td>{{ h.status_pill(u.role) }}</td>
            <td><span class="text-muted small">{{ u.created_at|date('M j, Y') }}</span></td>
            <td class="text-end">
              <div class="row-actions justify-content-end">
                <a class="btn btn-sm btn-outline-primary" href="/admin/users/{{ u.id }}/edit" title="Edit"><i class="ri ri-pencil-line"></i></a>
                {% if auth.id != u.id %}
                  {{ h.delete_button('/admin/users/' ~ u.id ~ '/delete', {icon_only: true, title: 'Delete this user?', text: 'The user "' ~ u.name ~ '" will lose access immediately.'}) }}
                {% endif %}
              </div>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
