<!doctype html>
<html lang="en" data-bs-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="robots" content="noindex,nofollow">
  <title>{% block title %}Admin{% endblock %} · {{ site.name }}</title>

  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

  <link rel="stylesheet" href="{{ asset('css/admin.css') }}">

  {% block head_extra %}{% endblock %}
</head>
<body class="admin">

<nav class="admin-topnav d-lg-none">
  <button class="btn btn-link admin-topnav-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-label="Open menu">
    <i class="ri ri-menu-line"></i>
  </button>
  <a href="/admin" class="admin-topnav-brand">
    {% if site.logo %}
      <img src="{{ site.logo }}" alt="{{ site.name }}">
    {% else %}
      <span>{{ site.name }}</span>
    {% endif %}
  </a>
  <span class="admin-topnav-spacer"></span>
</nav>

<div class="admin-shell">

  <aside class="admin-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarLabel">
    <div class="offcanvas-header d-lg-none">
      <h6 id="adminSidebarLabel" class="offcanvas-title text-white mb-0">Menu</h6>
      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0 d-flex flex-column">
      <a href="/admin" class="admin-brand">
        {% if site.logo %}
          <span class="admin-brand-logo"><img src="{{ site.logo }}" alt="{{ site.name }}" loading="lazy"></span>
        {% else %}
          <span class="admin-brand-mark">M</span>
          <span class="admin-brand-text"><b>MYN</b><small>Admin panel</small></span>
        {% endif %}
      </a>

      <ul class="admin-nav nav nav-pills flex-column">
        <li class="nav-item">
          <a href="/admin" class="nav-link{{ current_path == '/admin' ? ' active' : '' }}">
            <i class="ri ri-dashboard-line"></i><span>Dashboard</span>
          </a>
        </li>

        <li class="nav-section">Content</li>
        <li class="nav-item"><a href="/admin/posts"    class="nav-link{{ current_path starts with '/admin/posts'    ? ' active' : '' }}"><i class="ri ri-newspaper-line"></i><span>Posts</span></a></li>
        <li class="nav-item"><a href="/admin/programs" class="nav-link{{ current_path starts with '/admin/programs' ? ' active' : '' }}"><i class="ri ri-organization-chart"></i><span>Programs</span></a></li>
        <li class="nav-item"><a href="/admin/events"   class="nav-link{{ current_path starts with '/admin/events'   ? ' active' : '' }}"><i class="ri ri-calendar-event-line"></i><span>Events</span></a></li>
        <li class="nav-item"><a href="/admin/pages"    class="nav-link{{ current_path starts with '/admin/pages'    ? ' active' : '' }}"><i class="ri ri-file-text-line"></i><span>Pages</span></a></li>

        <li class="nav-section">Site</li>
        <li class="nav-item"><a href="/admin/stats"    class="nav-link{{ current_path starts with '/admin/stats'    ? ' active' : '' }}"><i class="ri ri-bar-chart-line"></i><span>Stats</span></a></li>
        <li class="nav-item"><a href="/admin/partners" class="nav-link{{ current_path starts with '/admin/partners' ? ' active' : '' }}"><i class="ri ri-team-line"></i><span>Partners</span></a></li>
        <li class="nav-item"><a href="/admin/settings" class="nav-link{{ current_path starts with '/admin/settings' ? ' active' : '' }}"><i class="ri ri-equalizer-line"></i><span>Settings</span></a></li>

        <li class="nav-section">Inbox</li>
        <li class="nav-item">
          <a href="/admin/messages" class="nav-link{{ current_path starts with '/admin/messages' ? ' active' : '' }}">
            <i class="ri ri-mail-line"></i><span>Messages</span>
            {% if unread_count|default(0) > 0 %}<span class="badge bg-warning text-dark ms-auto">{{ unread_count }}</span>{% endif %}
          </a>
        </li>
        <li class="nav-item"><a href="/admin/volunteers" class="nav-link{{ current_path starts with '/admin/volunteers' ? ' active' : '' }}"><i class="ri ri-user-add-line"></i><span>Volunteers</span></a></li>
        <li class="nav-item"><a href="/admin/donations"  class="nav-link{{ current_path starts with '/admin/donations'  ? ' active' : '' }}"><i class="ri ri-money-dollar-circle-line"></i><span>Donations</span></a></li>

        {% if auth and auth.role == 'admin' %}
        <li class="nav-section">Admin</li>
        <li class="nav-item"><a href="/admin/users" class="nav-link{{ current_path starts with '/admin/users' ? ' active' : '' }}"><i class="ri ri-shield-keyhole-line"></i><span>Users</span></a></li>
        {% endif %}
      </ul>

      <div class="admin-user">
        <div class="admin-user-info">
          <div class="admin-user-name">{{ auth.name|default('—') }}</div>
          <div class="admin-user-role">{{ auth.role|default('') }}</div>
        </div>
        <form method="post" action="/admin/logout" class="m-0">
          {{ csrf_field()|raw }}
          <button type="submit" class="btn btn-sm btn-outline-light" title="Sign out" aria-label="Sign out"><i class="ri ri-logout-box-r-line"></i></button>
        </form>
      </div>
    </div>
  </aside>

  <main class="admin-main">
    {% block breadcrumb %}{% endblock %}

    <div class="admin-topbar">
      <div class="admin-topbar-text">
        <h1 class="admin-page-title">{% block heading %}{{ block('title') }}{% endblock %}</h1>
        {% block subtitle %}{% endblock %}
      </div>
      <div class="admin-topbar-actions">
        {% block actions %}{% endblock %}
      </div>
    </div>

    {% block content %}{% endblock %}
  </main>

</div>

{% if flash is defined and flash|length > 0 %}
<script id="admin-flash-data" type="application/json">{{ flash|json_encode|raw }}</script>
{% endif %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.js"></script>
{% block scripts_extra %}{% endblock %}
<script src="{{ asset('js/admin.js') }}"></script>

</body>
</html>
