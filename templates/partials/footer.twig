<footer class="site-footer" id="footer">
  <div class="wrap">
    <div class="foot-top">
      <a href="/" class="foot-brand">
        {% if site.logo %}
          <div class="brand-logo-light"><img src="{{ site.logo }}" alt="{{ site.name }}" width="160" height="44" loading="lazy"></div>
        {% else %}
          <div class="brand"><span class="mark">M</span><span>{{ site.name }}</span></div>
        {% endif %}
      </a>
      <div class="socials">
        <a href="{{ site.facebook|default('#') }}" aria-label="Facebook">f</a>
        <a href="{{ site.twitter|default('#') }}" aria-label="X">X</a>
        <a href="{{ site.linkedin|default('#') }}" aria-label="LinkedIn">in</a>
        <a href="{{ site.instagram|default('#') }}" aria-label="Instagram">ig</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© {{ year }} {{ site.name }}. All rights reserved.</span>
      <nav class="foot-bottom-links">
        <a href="/about">About Us</a>
        <a href="/contact">Contact Us</a>
        <a href="/contact#location">Visit Us</a>
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms">Terms &amp; Conditions</a>
      </nav>
    </div>
  </div>
</footer>
