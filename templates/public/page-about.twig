{% extends 'layouts/base.twig' %}

{% block title %}{{ page.title }}{% endblock %}
{% block meta_description %}{{ page.meta_desc|default(page.title) }}{% endblock %}
{% block canonical_path %}/{{ page.slug }}{% endblock %}
{% block og_image_url %}{{ page.hero_image|default(site.logo_square|default('/assets/img/logo-square.png')) }}{% endblock %}
{% block og_image %}{% if page.hero_image %}<meta property="og:image" content="{{ page.hero_image }}">{% endif %}{% endblock %}

{% block content %}
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">Who We Are</span>
    <h1>{{ page.title }}</h1>
    {% if page.meta_desc %}
      <p>{{ page.meta_desc }}</p>
    {% endif %}
  </div>
</section>

{% if page.hero_image %}
<div class="wrap" style="margin-top:-24px">
  <img src="{{ page.hero_image }}" alt="{{ page.title }}"
       style="border-radius:24px;max-height:520px;width:100%;object-fit:cover" loading="lazy">
</div>
{% endif %}

<section class="pad">
  <div class="wrap">
    <div class="prose">{{ page.body|raw }}</div>
  </div>
</section>

{# ---------- Mission & Vision ---------- #}
<section class="pad mv-section">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">What Guides Us</span>
      <h2>Our Mission &amp; Vision</h2>
      <p>Two simple statements anchor every program, partnership and policy we touch.</p>
    </div>
    <div class="mv-grid">
      <article class="mv-card reveal">
        <div class="mv-card-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"></circle>
            <circle cx="12" cy="12" r="5"></circle>
            <circle cx="12" cy="12" r="1.5" fill="currentColor"></circle>
            <path d="M12 3v3M12 18v3M3 12h3M18 12h3"></path>
          </svg>
        </div>
        <h3>Our Mission</h3>
        <p>To enhance the purpose, rights and talents of young people as active citizens and agents of change &mdash; mobilizing, collaborating, empowering and transforming youth across Makueni County.</p>
      </article>
      <article class="mv-card reveal">
        <div class="mv-card-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </div>
        <h3>Our Vision</h3>
        <p>A just community where young people enjoy dignified lives &mdash; with the voice, opportunity and dignity to shape their own futures.</p>
      </article>
    </div>
  </div>
</section>

{# ---------- Core Values ---------- #}
<section class="pad cv-section">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">What We Stand For</span>
      <h2>Our Core Values</h2>
      <p>Six principles we test every decision against &mdash; from the county hall to the village meeting.</p>
    </div>

    {% set _values = [
      {'title': 'Youth Leadership', 'desc': 'We trust young people to lead. Programs are built with, not for, our members.', 'icon': 'leadership'},
      {'title': 'Collaboration',    'desc': 'We work shoulder-to-shoulder with partners, peers and the communities we serve.', 'icon': 'handshake'},
      {'title': 'Empowerment',      'desc': 'We unlock the skills, voice and resources every young person needs to act.',     'icon': 'spark'},
      {'title': 'Transformation',   'desc': 'We measure success in changed systems &mdash; not just completed workshops.',    'icon': 'arrows'},
      {'title': 'Integrity',        'desc': 'Honest with our members, transparent with our partners, accountable to all.',     'icon': 'shield'},
      {'title': 'Inclusion',        'desc': 'Every young person belongs here &mdash; across gender, ability, faith and circumstance.', 'icon': 'people'}
    ] %}

    <div class="cv-grid">
      {% for v in _values %}
        <article class="cv-card reveal">
          <div class="cv-card-icon" aria-hidden="true">
            {% if v.icon == 'leadership' %}
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 21V10l7-6 7 6v11"></path>
                <path d="M9 21v-7h6v7"></path>
              </svg>
            {% elseif v.icon == 'handshake' %}
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 17l-3-3 4-4 3 3"></path>
                <path d="M7 13l-4-4 3-3 4 4"></path>
                <path d="M14 12l4-4 3 3-4 4"></path>
                <path d="M18 13l-7 7"></path>
              </svg>
            {% elseif v.icon == 'spark' %}
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"></path>
                <circle cx="12" cy="12" r="3.5"></circle>
              </svg>
            {% elseif v.icon == 'arrows' %}
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12a9 9 0 1 1-3-6.7"></path>
                <path d="M21 4v5h-5"></path>
              </svg>
            {% elseif v.icon == 'shield' %}
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3l8 3v6c0 5-3.5 8.5-8 9-4.5-.5-8-4-8-9V6l8-3z"></path>
                <path d="M9 12l2 2 4-4"></path>
              </svg>
            {% else %}
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="8" cy="9" r="3"></circle>
                <circle cx="16" cy="9" r="3"></circle>
                <path d="M2 20c.6-3 3-5 6-5s5.4 2 6 5"></path>
                <path d="M14 15c.6-3 3-5 6-5"></path>
              </svg>
            {% endif %}
          </div>
          <h4>{{ v.title }}</h4>
          <p>{{ v.desc|raw }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endblock %}
