{% extends 'layouts/base.twig' %}

{% block title %}Page not found{% endblock %}

{% block content %}
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">404</span>
    <h1>That page seems to be out advocating somewhere.</h1>
    <p>We couldn't find what you were looking for. Try the homepage, or one of our programs.</p>
    <div class="hero-actions" style="margin-top:30px">
      <a href="/" class="btn btn-green">Back to home</a>
      <a href="/programs" class="btn btn-ghost">See our programs</a>
    </div>
  </div>
</section>
{% endblock %}
