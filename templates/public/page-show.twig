{% extends 'layouts/base.twig' %}

{% block title %}{{ page.title }}{% endblock %}
{% block meta_description %}{{ page.meta_desc|default(page.title) }}{% endblock %}
{% block og_image %}{% if page.hero_image %}<meta property="og:image" content="{{ page.hero_image }}">{% endif %}{% endblock %}

{% block content %}
<section class="page-hero">
  <div class="wrap">
    <h1>{{ page.title }}</h1>
  </div>
</section>

{% if page.hero_image %}
<div class="wrap" style="margin-top:-24px">
  <img src="{{ page.hero_image }}" alt="{{ page.title }}" style="border-radius:24px;max-height:520px;width:100%;object-fit:cover" loading="lazy">
</div>
{% endif %}

<section class="pad">
  <div class="wrap">
    <div class="prose">{{ page.body|raw }}</div>
  </div>
</section>
{% endblock %}
