{% extends 'layouts/base.twig' %}

{% block title %}{{ post.title }}{% endblock %}
{% block meta_description %}{{ post.excerpt|default(post.title) }}{% endblock %}
{% block og_type %}article{% endblock %}
{% block canonical_path %}/impact/{{ post.slug }}{% endblock %}
{% block og_image_url %}{{ post.cover_image|default(site.logo_square|default('/assets/img/logo-square.png')) }}{% endblock %}
{% block og_image %}{% if post.cover_image %}<meta property="og:image" content="{{ post.cover_image }}">{% endif %}{% endblock %}

{% block head_meta %}
  <meta property="article:published_time" content="{{ post.published_at|date('c') }}">
  {% if post.author_name %}<meta property="article:author" content="{{ post.author_name }}">{% endif %}
  {% if post.category_name %}<meta property="article:section" content="{{ post.category_name }}">{% endif %}
{% endblock %}

{% block head_jsonld %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline":     {{ post.title|json_encode|raw }},
  "datePublished":"{{ post.published_at|date('c') }}",
  {% if post.author_name %}"author":{ "@type":"Person", "name": {{ post.author_name|json_encode|raw }} },{% endif %}
  "image":        {{ (post.cover_image ?: (site.logo_square|default('/assets/img/logo-square.png')))|json_encode|raw }},
  "publisher": {
    "@type":"Organization",
    "name":  {{ site.name|json_encode|raw }},
    "logo":  { "@type":"ImageObject", "url": {{ (site.logo|default('/assets/img/logo.png'))|json_encode|raw }} }
  },
  "mainEntityOfPage": {
    "@type":"WebPage",
    "@id":   "{{ app_url|trim('/') }}/impact/{{ post.slug }}"
  },
  "description": {{ (post.excerpt ?: post.title)|json_encode|raw }}
}
</script>
{% endblock %}

{% block content %}
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">{{ post.category_name|default('News') }}</span>
    <h1>{{ post.title }}</h1>
    <p style="color:var(--muted);font-size:.94rem">
      Published {{ post.published_at|date('F j, Y') }}{% if post.author_name %} · By {{ post.author_name }}{% endif %}
    </p>
  </div>
</section>

{% if post.cover_image %}
<div class="wrap" style="margin-top:-24px">
  <img src="{{ post.cover_image }}" alt="{{ post.title }}" style="border-radius:24px;max-height:520px;width:100%;object-fit:cover" loading="lazy">
</div>
{% endif %}

<section class="pad">
  <div class="wrap">
    <div class="prose">{{ post.body|raw }}</div>

    <p style="text-align:center;margin-top:64px">
      <a href="/impact" class="btn btn-ghost">← All stories</a>
    </p>
  </div>
</section>
{% endblock %}
