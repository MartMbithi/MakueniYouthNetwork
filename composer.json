{
    "name": "makueniyouth/cms",
    "description": "Makueni Youth Network — custom PHP CMS",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "twig/twig": "^3.8",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
